{
  "name": "Ecommerce",
  "compatibilityLevel": 1567,
  "model": {
    "culture": "en-GB",
    "sourceQueryCulture": "en-GB",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "dataAccessOptions": {
      "legacyRedirects": true,
      "returnErrorValuesAsNull": true
    },
    "tables": [
      {
        "name": "Sales",
        "description": "Uploaded order records. One row per order in the supplied workbook.",
        "lineageTag": "57f8d2ca-2e46-56e0-abd6-52da196860ad",
        "columns": [
          {
            "name": "Order ID",
            "dataType": "string",
            "sourceColumn": "Order ID",
            "summarizeBy": "none",
            "lineageTag": "81119696-526b-5abb-a87d-8b8f0f630bd0"
          },
          {
            "name": "Order Date",
            "dataType": "dateTime",
            "sourceColumn": "Order Date",
            "summarizeBy": "none",
            "lineageTag": "636a94f1-5bf2-5123-9700-87843d8bb208",
            "formatString": "dd MMM yyyy",
            "annotations": [
              {
                "name": "UnderlyingDateTimeDataType",
                "value": "Date"
              }
            ]
          },
          {
            "name": "Employee",
            "dataType": "string",
            "sourceColumn": "Employee",
            "summarizeBy": "none",
            "lineageTag": "7f84dc79-8e5c-598c-bcd1-537087100148"
          },
          {
            "name": "State",
            "dataType": "string",
            "sourceColumn": "State",
            "summarizeBy": "none",
            "lineageTag": "4dfd6dae-e0f2-5a4e-bebb-fd2a50c97cc5"
          },
          {
            "name": "City",
            "dataType": "string",
            "sourceColumn": "City",
            "summarizeBy": "none",
            "lineageTag": "df1a70b5-644f-5746-a96a-6cd736c8b90c"
          },
          {
            "name": "Quantity",
            "dataType": "int64",
            "sourceColumn": "Quantity",
            "summarizeBy": "none",
            "lineageTag": "a2fd1059-22c3-5c5c-a483-813f4bb9f934",
            "formatString": "#,##0;(#,##0);0",
            "isHidden": true
          },
          {
            "name": "Category",
            "dataType": "string",
            "sourceColumn": "Category",
            "summarizeBy": "none",
            "lineageTag": "921e81b6-643b-52ba-95bd-757a0ccf4b09",
            "isHidden": true
          },
          {
            "name": "Sub-Category",
            "dataType": "string",
            "sourceColumn": "Sub-Category",
            "summarizeBy": "none",
            "lineageTag": "74bbc33b-2ed8-5a1a-a526-c215aa512a28"
          },
          {
            "name": "Sale",
            "dataType": "decimal",
            "sourceColumn": "Sale",
            "summarizeBy": "none",
            "lineageTag": "1ac4a9f4-f0d8-5e11-b742-49aa4fed0a5e",
            "formatString": "#,##0;(#,##0);0",
            "isHidden": true
          },
          {
            "name": "Profit",
            "dataType": "decimal",
            "sourceColumn": "Profit",
            "summarizeBy": "none",
            "lineageTag": "1e8767fc-444c-552c-b831-6f68e284da93",
            "formatString": "#,##0;(#,##0);0",
            "isHidden": true
          },
          {
            "name": "Month start",
            "dataType": "dateTime",
            "sourceColumn": "Month start",
            "summarizeBy": "none",
            "lineageTag": "285b10f7-1f74-5f3e-b226-fa630f7bf433",
            "formatString": "dd MMM yyyy",
            "annotations": [
              {
                "name": "UnderlyingDateTimeDataType",
                "value": "Date"
              }
            ],
            "isHidden": true
          }
        ],
        "partitions": [
          {
            "name": "Sales",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    File = if SourceFolder = null or Text.Trim(SourceFolder) = \"\" then",
                "        Binary.FromText(Text.Combine({\"\",",
                "        \"\",",
                "        \"\",",
                "        \"\",",
                "        \"\",",
                "        \"\",",
                "        \"\",",
                "        \"\",",
                "        \"\",",
                "        \"\",",
                "        \"\",",
                "        \"\",",
                "        \"\",",
                "        \"\"}), BinaryEncoding.Base64)",
                "    else File.Contents(Text.TrimEnd(SourceFolder, {\"/\", Character.FromNumber(92)}) & \"/E-commerce dataset.xlsx\"),",
                "    Sheet = Excel.Workbook(File, null, true){[Item=\"Sheet1\", Kind=\"Sheet\"]}[Data],",
                "    Headers = Table.PromoteHeaders(Sheet, [PromoteAllScalars=true]),",
                "    Required = Table.SelectColumns(Headers, {\"Order ID\",\"Order Date\",\"Employee\",\"State\",\"City\",\"Quantity\",\"Category\",\"Sub-Category\",\"Sale\",\"Profit\"}),",
                "    CleanRows = Table.SelectRows(Required, each [Order ID] <> null and Text.Trim(Text.From([Order ID])) <> \"\"),",
                "    Typed = Table.TransformColumnTypes(CleanRows, {{\"Order ID\",type text},{\"Order Date\",type date},{\"Employee\",type text},{\"State\",type text},{\"City\",type text},{\"Quantity\",Int64.Type},{\"Category\",type text},{\"Sub-Category\",type text},{\"Sale\",Currency.Type},{\"Profit\",Currency.Type}}, \"en-GB\"),",
                "    CleanKeys = Table.TransformColumns(Typed, {{\"Category\",Text.Trim,type text},{\"Order ID\",Text.Trim,type text}}),",
                "    MonthKey = Table.AddColumn(CleanKeys,\"Month start\", each Date.StartOfMonth([Order Date]),type date)",
                "in",
                "    MonthKey"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Total sales",
            "expression": "SUM ( 'Sales'[Sale] )",
            "formatString": "#,##0;(#,##0);0",
            "description": "Sum of recorded order sales.",
            "lineageTag": "5419227c-6d84-5a27-8548-0b14078fbe17"
          },
          {
            "name": "Net profit",
            "expression": "SUM ( 'Sales'[Profit] )",
            "formatString": "#,##0;(#,##0);0",
            "description": "Includes profitable and loss-making orders.",
            "lineageTag": "34a6ff15-f7f4-548c-85bf-6ed196e94e80"
          },
          {
            "name": "Profit margin",
            "expression": "DIVIDE ( [Net profit], [Total sales] )",
            "formatString": "0.0%;(0.0%);0.0%",
            "description": "Sales-weighted profit margin under the current filters.",
            "lineageTag": "2b690721-bc91-5d58-8db6-9da4e79170f0"
          },
          {
            "name": "Orders",
            "expression": "DISTINCTCOUNT ( 'Sales'[Order ID] )",
            "formatString": "#,##0;(#,##0);0",
            "description": "Number of distinct order identifiers.",
            "lineageTag": "07ef7faf-708f-5ef7-8766-acad1f94d1d7"
          },
          {
            "name": "Units sold",
            "expression": "SUM ( 'Sales'[Quantity] )",
            "formatString": "#,##0;(#,##0);0",
            "description": "Total quantity on the selected orders.",
            "lineageTag": "6e3e32f9-2323-54b9-a24b-649bad5a2ea5"
          },
          {
            "name": "Avg order value",
            "expression": "DIVIDE ( [Total sales], [Orders] )",
            "formatString": "#,##0.00;(#,##0.00);0.00",
            "description": "Sales per distinct order.",
            "lineageTag": "c993bb85-83f8-5158-88f8-aa264d6a8f83"
          },
          {
            "name": "Loss-making orders",
            "expression": "COUNTROWS ( FILTER ( VALUES ( 'Sales'[Order ID] ), [Net profit] < 0 ) ) + 0",
            "formatString": "#,##0;(#,##0);0",
            "description": "Distinct orders with negative summed profit in the current selection.",
            "lineageTag": "037a07cc-acad-5725-89f6-ce4af89c9145"
          }
        ]
      },
      {
        "name": "Targets",
        "description": "Sales targets supplied at the category and month level.",
        "lineageTag": "85740faa-12ef-56ae-bc48-413dcb6151d3",
        "columns": [
          {
            "name": "Month start",
            "dataType": "dateTime",
            "sourceColumn": "Month start",
            "summarizeBy": "none",
            "lineageTag": "754d9e3d-63c4-5efe-a8c0-955891523526",
            "formatString": "dd MMM yyyy",
            "annotations": [
              {
                "name": "UnderlyingDateTimeDataType",
                "value": "Date"
              }
            ],
            "isHidden": true
          },
          {
            "name": "Category",
            "dataType": "string",
            "sourceColumn": "Category",
            "summarizeBy": "none",
            "lineageTag": "2112e368-3e98-5073-8c0c-238a40995826",
            "isHidden": true
          },
          {
            "name": "Target amount",
            "dataType": "decimal",
            "sourceColumn": "Target amount",
            "summarizeBy": "none",
            "lineageTag": "3ad4641c-de23-58a8-bee6-7039beb4b098",
            "formatString": "#,##0;(#,##0);0",
            "isHidden": true
          }
        ],
        "partitions": [
          {
            "name": "Targets",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    File = if SourceFolder = null or Text.Trim(SourceFolder) = \"\" then",
                "        Binary.FromText(Text.Combine({\"\"}), BinaryEncoding.Base64)",
                "    else File.Contents(Text.TrimEnd(SourceFolder, {\"/\", Character.FromNumber(92)}) & \"/Sales target.csv\"),",
                "    Raw = Csv.Document(File, [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Raw, [PromoteAllScalars=true]),",
                "    Names = Table.RenameColumns(Headers, {{\"Month of Order Date\",\"Month start\"},{\"Target\",\"Target amount\"}}),",
                "    Required = Table.SelectColumns(Names,{\"Month start\",\"Category\",\"Target amount\"}),",
                "    CleanRows = Table.SelectRows(Required, each [Month start] <> null and Text.Trim([Month start]) <> \"\"),",
                "    Typed = Table.TransformColumns(CleanRows, {{\"Month start\", each Date.StartOfMonth(Date.FromText(Text.Trim(_),[Format=\"dd-MM-yyyy\",Culture=\"en-GB\"])),type date},{\"Category\",Text.Trim,type text},{\"Target amount\",each Currency.From(_, \"en-GB\"),Currency.Type}})",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Sales target",
            "expression": "IF ( NOT ISFILTERED ( 'Sales' ), SUM ( 'Targets'[Target amount] ) )",
            "formatString": "#,##0;(#,##0);0",
            "description": "Sum of category-month targets from Sales target.csv. A direct order-level filter suppresses the target because the plan has no allocation at that level.",
            "lineageTag": "48bdc9d4-02e9-5c51-ab62-9bc0694d28d4"
          },
          {
            "name": "Target attainment",
            "expression": "DIVIDE ( [Total sales], [Sales target] )",
            "formatString": "0.0%;(0.0%);0.0%",
            "description": "Selected sales divided by the matching selected target.",
            "lineageTag": "3f4a2fea-d53b-5f04-a42f-9a07e3ceddb0"
          },
          {
            "name": "Gap to target",
            "expression": "IF ( NOT ISBLANK ( [Sales target] ), [Total sales] - [Sales target] )",
            "formatString": "#,##0;(#,##0);0",
            "description": "Actual sales minus the matching target. Parentheses indicate a shortfall.",
            "lineageTag": "e32bdd9a-e4fa-5835-8330-76ee771102c4"
          }
        ]
      },
      {
        "name": "Period",
        "description": "Shared month selection for actuals and targets.",
        "lineageTag": "bfa743d4-fd9a-5493-9003-f70f2440ec38",
        "columns": [
          {
            "name": "Month start",
            "dataType": "dateTime",
            "sourceColumn": "Month start",
            "summarizeBy": "none",
            "lineageTag": "8f7aaf17-55d8-5920-b19f-4a818762f2a7",
            "formatString": "dd MMM yyyy",
            "annotations": [
              {
                "name": "UnderlyingDateTimeDataType",
                "value": "Date"
              }
            ],
            "isHidden": true
          },
          {
            "name": "Month",
            "dataType": "string",
            "sourceColumn": "Month",
            "summarizeBy": "none",
            "lineageTag": "3df8e0ee-dc9b-5ece-9d94-9148031695fe",
            "sortByColumn": "Month start"
          }
        ],
        "partitions": [
          {
            "name": "Period",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Keys = List.Sort(List.Distinct(List.Combine({Sales[Month start],Targets[Month start]}))),",
                "    Months = Table.FromColumns({Keys},type table [Month start=date]),",
                "    Labels = Table.AddColumn(Months,\"Month\",each Date.ToText([Month start],\"MMM yy\",\"en-GB\"),type text)",
                "in",
                "    Labels"
              ]
            }
          }
        ]
      },
      {
        "name": "Product category",
        "description": "Shared category selection for actuals and targets.",
        "lineageTag": "c2b970bd-1b1e-53a0-be10-6ff47c214944",
        "columns": [
          {
            "name": "Category",
            "dataType": "string",
            "sourceColumn": "Category",
            "summarizeBy": "none",
            "lineageTag": "0038bbeb-1249-53ae-be90-250ae7a3fd5c"
          }
        ],
        "partitions": [
          {
            "name": "Product category",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Keys = List.Sort(List.Distinct(List.Combine({Sales[Category],Targets[Category]}))),",
                "    Categories = Table.FromColumns({Keys},type table [Category=text])",
                "in",
                "    Categories"
              ]
            }
          }
        ]
      }
    ],
    "relationships": [
      {
        "name": "13bb387b-6c13-50b3-8114-14184735185b",
        "fromTable": "Sales",
        "fromColumn": "Month start",
        "toTable": "Period",
        "toColumn": "Month start",
        "fromCardinality": "many",
        "toCardinality": "one",
        "crossFilteringBehavior": "oneDirection"
      },
      {
        "name": "e873ffa0-d82c-51dd-8be1-417edb5381c3",
        "fromTable": "Sales",
        "fromColumn": "Category",
        "toTable": "Product category",
        "toColumn": "Category",
        "fromCardinality": "many",
        "toCardinality": "one",
        "crossFilteringBehavior": "oneDirection"
      },
      {
        "name": "f825aa27-c89f-5de0-882a-cf62a62495cc",
        "fromTable": "Targets",
        "fromColumn": "Month start",
        "toTable": "Period",
        "toColumn": "Month start",
        "fromCardinality": "many",
        "toCardinality": "one",
        "crossFilteringBehavior": "oneDirection"
      },
      {
        "name": "7636ca55-f5aa-561f-9d9c-a1b96e6ca3fd",
        "fromTable": "Targets",
        "fromColumn": "Category",
        "toTable": "Product category",
        "toColumn": "Category",
        "fromCardinality": "many",
        "toCardinality": "one",
        "crossFilteringBehavior": "oneDirection"
      }
    ],
    "expressions": [
      {
        "name": "SourceFolder",
        "kind": "m",
        "description": "Leave empty to use the embedded workbook and target CSV. Set to a folder containing the two original filenames to refresh from files.",
        "expression": "\"\" meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=false]",
        "lineageTag": "703a1538-a08d-5bde-a19c-7e0aebc57a99"
      }
    ],
    "annotations": [
      {
        "name": "PBI_QueryOrder",
        "value": "[\"SourceFolder\", \"Sales\", \"Targets\", \"Period\", \"Product category\"]"
      },
      {
        "name": "__PBI_TimeIntelligenceEnabled",
        "value": "0"
      }
    ]
  }
}
